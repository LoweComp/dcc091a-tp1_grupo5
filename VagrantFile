Vagrant.configure("2") do |config|
  # Mesma box base (armazenamento) 
  config.vm.box = "ubuntu/jammy64"

  # VM 1: Bastion & Proxy Master
  config.vm.define "bastion" do |b|
    b.vm.network "private_network", ip: "192.168.56.10"
    b.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
      v.name = "dcc091a-vm1-bastion"
      v.gui = false
    end
  end

  # VM 2: K3s Control Plane
  config.vm.define "k3s-server" do |k2|
    k2.vm.network "private_network", ip: "192.168.56.20"
    k2.vm.provider "virtualbox" do |v|
      v.memory = 2048
      v.cpus = 2
      v.name = "dcc091a-vm2-k3s-server"
      v.gui = false
    end
  end

  # VM 3: K3s Worker
  config.vm.define "k3s-worker" do |k3|
    k3.vm.network "private_network", ip: "192.168.56.30"
    k3.vm.provider "virtualbox" do |v|
      v.memory = 2048
      v.cpus = 2
      v.name = "dcc091a-vm3-k3s-worker"
      v.gui = false
    end
  end

  # VM 4: Auxiliary & Proxy Backup (Persistencia)
  config.vm.define "auxiliary" do |a|
    a.vm.network "private_network", ip: "192.168.56.40"
    a.vm.synced_folder "./data_backup", "/var/lib/app_data", create: true
    a.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
      v.name = "dcc091a-vm4-auxiliary"
      v.gui = false
    end
  end
end