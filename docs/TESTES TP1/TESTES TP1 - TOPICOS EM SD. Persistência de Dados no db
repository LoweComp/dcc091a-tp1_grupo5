4. PERSISTÊNCIA DE DADOS NO DB

TESTES ANTERIORES:
vagrant ssh db
ls -la /var/lib/dados_persistentes/
cat /var/lib/dados_persistentes/banco_teste.txt

TESTE LIVE:
bash -c 'for i in {1..5}; do echo "[$(date)] Teste de desastre [LIVE] - Linha $i" | sudo tee -a /var/lib/dados_persistentes/log_survivor.txt; sleep 1; done'
cat /var/lib/dados_persistentes/log_survivor.txt
exit

vagrant destroy -f db
vagrant up db
vagrant ssh db
cat /var/lib/dados_persistentes/log_survivor.txt

REINTEGRAR CHAVE E REGRAS DE SEGURANÇA AO BD:
vagrant ssh db -c "cat /vagrant/chave_bastion.pub >> ~/.ssh/authorized_keys"
vagrant ssh bastion -c "ansible-playbook -i /home/vagrant/ansible/inventory.ini /home/vagrant/ansible/site.yml"

