Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.provider "virtualbox" do |vb|
    vb.linked_clone = true
  end

  # 1. NÓ DB (Servidor de Logs)
  config.vm.define "db" do |db|
    db.vm.network "private_network", ip: "192.168.56.30"
    db.vm.hostname = "db"
    db.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
  end

  # 2. NÓ BASTION (Gateway e Masquerade NAT)
  config.vm.define "bastion" do |bastion|
    bastion.vm.network "private_network", ip: "192.168.56.10"
    bastion.vm.hostname = "bastion"
    bastion.vm.provider "virtualbox" do |vb|
      vb.memory = "1024"
      vb.cpus = 1
    end
  end

  # 3. K3S MASTER (Control Panel)
  config.vm.define "master" do |master|
    master.vm.network "private_network", ip: "192.168.56.20"
    master.vm.hostname = "master"
    master.vm.provider "virtualbox" do |vb|
      vb.memory = "2048" 
      vb.cpus = 2
    end
  end

  # 4. K3S WORKERS (Nós Proletários)
  (1..2).each do |i|
    config.vm.define "worker#{i}" do |worker|
      worker.vm.network "private_network", ip: "192.168.56.2#{i}"
      worker.vm.hostname = "worker#{i}"
      worker.vm.provider "virtualbox" do |vb|
        vb.memory = "1536"
        vb.cpus = 1
      end
    end
  end
end